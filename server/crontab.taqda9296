# =====================================================================
# مهامّ تقدّر الدورية — تُنفَّذ بصلاحية taqda9296، مالك ملفّات الموقع.
#
# لماذا ليست في crontab الـroot: CodeIgniter يكتب الكاش والسجلّ أثناء
# الإقلاع. فلو أُقلع من مهمّة root صار أوّل ملفّ يكتبه مملوكًا لـroot،
# ثمّ يعجز الويب (nobody/taqda9296) عن الكتابة فوقه، فيقع الموقع في
# خطأ صامت لا يظهر إلّا بعد أن يفسد شيء. والمالك الواحد يقطع هذا.
#
# ويُستعمل مفسّر LiteSpeed نفسه (lsphp82) لا /usr/bin/php، ليكون
# نفسَ الإصدار والإضافات التي يعمل بها الموقع في الويب.
# =====================================================================

# ---------------------------------------------------------------------
# النشرة البريدية — معطَّلة عمدًا (٢٠٢٦-٠٨-٠٢)
#
# كانت تعمل كل ١٠ دقائق (١٤٤ مرّة يوميًّا) على ملفّ **غير موجود**:
#   /home/taqdaredu.com/public_html/uploads/cronjob/newsletter_cron.php
# والمجلّد فيه `.htaccess` فقط. وكل أثر كان يُبتلع بـ>/dev/null 2>&1،
# فكان الفشل صامتًا تمامًا.
#
# ولم تُصلَح بإنشاء الملفّ لسببين: (١) الملفّ لا يُكتب يدويًّا، بل يولّده
# مديرُ الموقع من لوحة التحكّم (الإعدادات ← النشرة البريدية ← زرّ
# "Create Cronjob file")، وهو يُدرج فيه مسارات التنصيب وقتَ التوليد؛
# (٢) الميزة غير مستعملة أصلًا: ٠ نشرة، ٠ مشترك، ٠ سجلّ إرسال.
#
# لإعادة التفعيل: أنشئ الملفّ من لوحة التحكّم، ثمّ أزل # من السطر التالي.
# */10 * * * * /usr/local/lsws/lsphp82/bin/php -q /home/taqdaredu.com/public_html/uploads/cronjob/newsletter_cron.php >> /home/taqdaredu.com/logs/newsletter_cron.log 2>&1
# ---------------------------------------------------------------------

# انتهاء الاشتراكات المستحقّة — نُقلت من crontab الـroot في ٢٠٢٦-٠٨-٠٢
0 2 * * * /usr/local/lsws/lsphp82/bin/php /home/taqdaredu.com/cron_taqdar.php taqdar_cron expire >> /home/taqdaredu.com/logs/taqdar_cron.log 2>&1

# تقليم سجلّات CodeIgniter المؤرَّخة (ضغط بعد ٧ أيّام، حذف بعد ٦٠)
# سجلّ CI فُعِّل حديثًا ويكتب ملفًّا لكل يوم، فبلا تقليم ينمو بلا حدّ.
40 4 * * * /usr/local/bin/taqdar-ci-logs-prune >/dev/null 2>&1
30 2 * * * /usr/local/lsws/lsphp82/bin/php /home/taqdaredu.com/cron_taqdar.php taqdar_cron_events run    >> /home/taqdaredu.com/logs/cron_events.log 2>&1
0 4 * * 0 /usr/local/lsws/lsphp82/bin/php /home/taqdaredu.com/cron_taqdar.php taqdar_cron_events weekly >> /home/taqdaredu.com/logs/cron_events.log 2>&1
10 * * * * /usr/local/lsws/lsphp82/bin/php /home/taqdaredu.com/cron_taqdar.php taqdar_cron expire_sessions >> /home/taqdaredu.com/logs/taqdar_cron.log 2>&1

# مزامنة دفعات تاب المعلقة — كل ربع ساعة
#
# من دفع ببطاقته ثم أغلق المتصفح قبل أن يعود يفعل اشتراكه بالويبهوك. وهذه
# المهمة تسد ما لو لم يصل الويبهوك: تسأل تاب عن كل محاولة بقيت «لم تكتمل»
# أكثر من خمسة عشر دقيقة، وتفعل ما حصل ماله. وبلا هذا السطر تبقى دفعة
# انقطع عنها النداء محصلة عند تاب والاشتراك مقفلا حتى يشتكي صاحبه.
# وتكرارها مأمون: المسوى لا يسوى مرتين.
*/15 * * * * /usr/local/lsws/lsphp82/bin/php /home/taqdaredu.com/cron_taqdar.php taqdar_cron reconcile >> /home/taqdaredu.com/logs/taqdar_cron.log 2>&1

# تنظيف رموز التحقق وسجل واتساب — مرة في اليوم
#
# `tq_otp` صف لكل رمز يصدر، وأكثرها لحسابات لم تكتمل؛ و`tq_wa_log` صف
# لكل رسالة واتساب تحاول. والجدولان لا يقرأ منهما إلا الأيام الأخيرة —
# ثلاثة للرموز (أطول من عمر الرمز بمراحل، وكافية لتشخيص «سجلت أمس ولم
# يصلني شيء») وتسعون للسجل (وهو ما يجيب عن «هل وصل إشعار دفعة الشهر
# الماضي؟»). وبلا هذا السطر يصيران أكبر جدولين في القاعدة.
15 3 * * * /usr/local/lsws/lsphp82/bin/php /home/taqdaredu.com/cron_taqdar.php taqdar_cron purge >> /home/taqdaredu.com/logs/taqdar_cron.log 2>&1

# تجسيد استحقاقات المشتركين — كل نصف ساعة
#
# صفوف `enrol` تكتب مرة واحدة عند تفعيل الاشتراك، فمحتوى ينشر بعد
# البيع لا يبلغ مشتركا قائما: يشاهد دروسه لأن الوصول يستعلم حيا،
# ويقرأ «لا كورسات بعد» في كل شاشة تضم الجدول.
#
# والنشر نفسه ينادي التجسيد فورا (`resync_scope`)، وهذه شبكة الأمان
# تحته: تلحق ما تعثر، وما كتب في القاعدة بيد أو باستيراد. ومأمونة
# التكرار — تدرج ما ينقص وتمدد الأجل ولا تحذف صفا لم تكتبه.
*/30 * * * * /usr/local/lsws/lsphp82/bin/php /home/taqdaredu.com/cron_taqdar.php taqdar_cron enrolments >> /home/taqdaredu.com/logs/taqdar_cron.log 2>&1
