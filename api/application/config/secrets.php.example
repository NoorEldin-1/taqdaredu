/*
| Per-environment secrets, merged into $config by config.php.
|
| Setup:  cp secrets.php.example secrets.php   then fill in the values.
| This file is committed; secrets.php is NOT (see root .gitignore).
|
| encryption_key: 32 hex chars. Generate one with:
|     php -r "echo bin2hex(random_bytes(16)), PHP_EOL;"
| Changing it invalidates all existing sessions and anything already
| encrypted with the old key, so only rotate it deliberately.
*/
return array(
	'encryption_key' => '',
);
