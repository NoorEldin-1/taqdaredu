# =============================================================
# API .htaccess for CodeIgniter backend
# Deploy to: public_html/api/.htaccess
# =============================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /api/

    # Block access to .git directory entirely (C-01)
    RewriteRule ^\.git(/.*)?$ - [F,L]

    # If file or directory exists, serve it directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # ---------------------------------------------------------------
    # Retire the legacy Academy LMS public site.
    #
    # The React SPA at the web root replaced it, but its server-rendered
    # pages stayed publicly reachable — a second, unbranded, English site
    # on the same domain with its own nav and logo. Send visitors to the
    # SPA equivalent instead.
    #
    # 302 (not 301) on purpose: browsers cache 301s aggressively and this
    # is a handover, so the client can still reverse the decision.
    #
    # Deliberately NOT redirected:
    #   login/*   — the admin panel's only entry point
    #   admin/*   — the admin panel itself
    #   api_*     — the SPA's JSON API
    #   seo/*     — server-rendered pages for crawlers
    # ---------------------------------------------------------------
    RewriteRule ^sign_up/?$            /register    [R=302,L]
    RewriteRule ^home/courses/?$       /courses     [R=302,L]
    RewriteRule ^home/blog(/.*)?$      /blogs       [R=302,L]
    RewriteRule ^home/about_us/?$      /about-us    [R=302,L]
    RewriteRule ^home/contact_us/?$    /contact-us  [R=302,L]
    RewriteRule ^home(/.*)?$           /            [R=302,L]

    # Route everything else to CodeIgniter index.php
    RewriteRule ^(.*)$ index.php/$1 [L]
</IfModule>

<IfModule mod_headers.c>
    # CORS headers — restricted to known origins only (M-01)
    # TODO(client): the previous owner's domain (my-communication.uk) was removed
    # from this allowlist. Add Tagdar's production domain here before launch, or
    # the deployed SPA will be blocked from calling its own API cross-origin.
    SetEnvIf Origin "^https?://(localhost(:[0-9]+)?|127\.0\.0\.1(:[0-9]+)?)$" CORS_ORIGIN=$0
    Header set Access-Control-Allow-Origin "%{CORS_ORIGIN}e" env=CORS_ORIGIN
    Header set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
    Header set Access-Control-Allow-Credentials "true"
    Header set Vary "Origin"

    # A2 fix (CSRF): CodeIgniter 3.1.9 predates the cookie_samesite config key,
    # so enforce SameSite=Lax on the admin/session cookie here. Only appends the
    # attribute when it isn't already present, so it never doubles up. Lax lets
    # the panel's own same-site navigation keep working while blocking cross-site
    # POST / subresource cookie sending — the practical CSRF vectors.
    Header always edit Set-Cookie "^(ci_session=(?:(?!;\s*SameSite).)*)$" "$1; SameSite=Lax"

    # no-transform: instruct Cloudflare not to modify returned responses, which also
    # stops it injecting its JS-Detections script (jsd/main.js) that uses deprecated
    # browser APIs and lowers the PageSpeed "Best Practices" score. Harmless on JSON
    # API responses; on static assets it only skips Cloudflare's image re-optimization
    # (the app already serves pre-optimized webp), so the impact is negligible.
    Header merge Cache-Control "no-transform"
</IfModule>

# Block access to sensitive files (C-01, M-05)
<FilesMatch "\.(git|env|bak|sql|zip|tgz|gz|tar|log|sh|map|postman_collection\.json|DS_Store|md)$">
    Require all denied
</FilesMatch>

# Block composer files (M-05) — they reveal library versions for CVE targeting
<Files "composer.json">
    Require all denied
</Files>
<Files "composer.lock">
    Require all denied
</Files>

# Block Python scripts (cleanup tools left in root)
<FilesMatch "\.py$">
    Require all denied
</FilesMatch>

# Block .htaccess direct reads
<FilesMatch "^\.ht">
    Require all denied
</FilesMatch>
