# Copy to .env.local and adjust. Only VITE_-prefixed vars reach the browser.

# Where the Vite dev server proxies /api/* during `npm run dev`.
# Point it at the Apache vhost serving this project's document root.
VITE_DEV_API_TARGET=http://localhost:8081

# Prefix prepended to every API path by src/lib/api/config.ts.
# Leave empty for same-origin (production, and dev via the proxy above).
# VITE_API_BASE_URL=
