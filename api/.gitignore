# ─── Secrets — NEVER commit ──────────────────────────────────
.env
.env.*
*.env
# ...except the templates, which hold no values. This negation must live in
# THIS file: a deeper .gitignore wins over the repo-root one, so the root's
# `!.env.example` alone cannot re-include front/.env.example.
!.env.example
!*.env.example

# ─── Test-runner binary & generated reports (regenerated) ────
# The test SOURCE (tests/, front/**/*.test.tsx, front/e2e/) IS tracked
# on purpose — only the downloadable phar and generated output are ignored.
phpunit-9.phar
.phpunit.result.cache
front/test-results/
front/playwright-report/
front/coverage/

# ─── Deploy artifacts & archives ─────────────────────────────
*.zip

# ─── Project backup convention (inert, .htaccess-blocked) ────
*.bak-*
*.before-*

# ─── OS / editor junk ────────────────────────────────────────
.DS_Store
__MACOSX/
Thumbs.db
