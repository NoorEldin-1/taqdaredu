# ============================================================
#  أسرار — المستودع عامّ، فهذه الملفات لا تُرفع إطلاقًا.
#  انسخ القالب المرافق (.example) واملأه بعد الاستنساخ.
# ============================================================
/application/config/database.php
/application/config/database.php.orig
/application/config/taqdar_secret.php

# ============================================================
#  محتوى المستخدمين — يُنسَخ من الخادم لا من المستودع.
#  تُستبقى ملفات index.html و .htaccess وحدها لأنّها حُرّاس
#  المجلّدات: بدونها يصير سرد المحتويات مكشوفًا.
# ============================================================
/uploads/**
!/uploads/**/
!/uploads/**/index.html
!/uploads/**/.htaccess

# ============================================================
#  مخرجات وقت التشغيل
# ============================================================
/application/cache/*
!/application/cache/index.html
/application/logs/*
!/application/logs/index.html
/backups/*
!/backups/index.html

# ============================================================
#  أدوات محلّية
# ============================================================
/vendor/
composer.lock
node_modules/
*.log
*.sql
*.sql.gz
*.zip
*.tar.gz
.DS_Store
Thumbs.db
.idea/
.vscode/
*.bak
*.bak-*
