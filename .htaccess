
# ---------------------------------------------------------------------
# ترويسات الأمان. `always` ضرورية: بدونها لا تُرسَل مع استجابات الخطأ،
# وصفحة الخطأ هي بالضبط ما يُستهدَف بالتأطير.
# ---------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
</IfModule>

# ---------------------------------------------------------------------
# البيئة. index.php يقرأ CI_ENV ويسقط إلى production حين لا يجدها،
# فتُبتلَع الأخطاء صامتةً — وهو الصواب أمام الزوّار والعطب أمام المطوّر.
# الشرط على المضيف وحده، فالإنتاج لا يُطابقه أبدًا.
# ---------------------------------------------------------------------
<IfModule mod_setenvif.c>
    SetEnvIf Host "^(localhost|127\.0\.0\.1)" CI_ENV=development
</IfModule>

# ---- Academy LMS / منصة تقدّر ----
# تحويل إجباري إلى HTTPS و www -> non-www
<IfModule mod_rewrite.c>
RewriteEngine On

# TQ-COURSES-301 — البيع صار بالباقة، فصفحة الموادّ وجهتُها الباقات.
# دائمٌ لا مؤقّت: الصفحة لن تعود، والمؤقّت يُبقي القديم في الفهارس.
RewriteRule ^courses/?$ /plans [R=301,L]
RewriteRule ^courses/(.*)$ /plans [R=301,L]

# التطوير المحلّي مستثنى: لا شهادة على localhost، والإجبار يقطع الخادم المحلّي.
# الشرط لا يُفعَّل في الإنتاج لأنّ المضيف هناك ليس localhost أبدًا.
RewriteCond %{HTTP_HOST} !^localhost [NC]
RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
</IfModule>

<IfModule mod_rewrite.c>

# تحويل الروابط القديمة إلى النظيفة — 301 حتى لا تضيع أرشفة ولا رابط محفوظ
RewriteRule ^home/?$ / [R=301,L]
RewriteRule ^home/courses/?$ /courses [R=301,L]
RewriteRule ^home/about_us/?$ /about [R=301,L]
RewriteRule ^home/contact_us/?$ /contact [R=301,L]
RewriteRule ^home/faq/?$ /faq [R=301,L]
RewriteRule ^home/terms_and_condition/?$ /terms [R=301,L]
RewriteRule ^home/privacy_policy/?$ /privacy [R=301,L]
RewriteRule ^home/refund_policy/?$ /refund [R=301,L]
RewriteRule ^home/my_courses/?$ /my-courses [R=301,L]
# الأخصّ قبل الأعمّ: القاعدة العامّة كانت تبتلع مسارَي المعلّم
# ووليّ الأمر فتحوّلهما إلى /student/... وهو عنوان غير موجود.
RewriteRule ^taqdar/teacher/?$ /teacher [R=301,L]
RewriteRule ^taqdar/teacher/(.*)$ /teacher/$1 [R=301,L]
RewriteRule ^taqdar/parent/?$ /parent [R=301,L]
RewriteRule ^taqdar/parent/(.*)$ /parent/$1 [R=301,L]
RewriteRule ^taqdar/?$ /student [R=301,L]
RewriteRule ^taqdar/(.*)$ /student/$1 [R=301,L]

RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?/$1 [L]
</IfModule>

# صفحات إعدادات لوحة الإدارة تتجاوز 1000 حقل
php_value max_input_vars 5000

# منع الوصول المباشر لملفات الترجمة ونسخ الإعدادات الاحتياطية
<FilesMatch "\.(orig|bak|sql|log)$">
    Require all denied
</FilesMatch>
