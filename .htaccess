
# ---------------------------------------------------------------------
# ترويسات الأمان. `always` ضرورية: بدونها لا تُرسَل مع استجابات الخطأ،
# وصفحة الخطأ هي بالضبط ما يُستهدَف بالتأطير.
# ---------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
</IfModule>

# ---------------------------------------------------------------------
# البيئة. index.php يقرأ CI_ENV ويسقط إلى production حين لا يجدها،
# فتُبتلَع الأخطاء صامتةً — وهو الصواب أمام الزوّار والعطب أمام المطوّر.
# الشرط على المضيف وحده، فالإنتاج لا يُطابقه أبدًا.
# ---------------------------------------------------------------------
<IfModule mod_setenvif.c>
    SetEnvIf Host "^(localhost|127\.0\.0\.1)" CI_ENV=development
</IfModule>

# ---- Academy LMS / منصة تقدّر ----
# تحويل إجباري إلى HTTPS و www -> non-www
<IfModule mod_rewrite.c>
RewriteEngine On

# ---------------------------------------------------------------------
# حجب أدوات المستودع — أوّلُ ما يُنفَّذ، قبل أيّ تحويل.
#
# المستودع يُستنسَخ داخل جذر الويب ليعمل `deploy.sh`، وقاعدةُ الواجهة
# الأماميّة أدناه تمرّر كلّ ملفٍّ موجودٍ فعلًا (`!-f`) إلى الخادم كما هو —
# وهذا مُتحقَّقٌ منه: `/composer.json` يُخدَم بـ200. فبلا هذه القواعد يصير
# `/.git/config` مقروءًا للعامّة، ومنه تُستخرَج الشجرة كاملةً.
#
# الحجب قبل التحويل لا بعده: المسار المحجوب لا يُعاد توجيهه أصلًا.
# ---------------------------------------------------------------------
RewriteRule (^|/)\.git(/|$)        - [F,L]
RewriteRule ^(server|scripts)(/|$) - [F,L]
RewriteRule (^|/)\.claude(/|$)     - [F,L]

# TQ-CATALOG-301 — الكتالوج الموحد بلع ثلاث صفحات.
# `/plans` صارت صفحة الباقات وحدها، و`/catalog` هي المواد والبرامج
# التعليمية بأنواعها الأربعة. فالمواد وجهتها الكتالوج لا الباقات،
# والكتب صارت نوعا فيه فتصل مرشحة عليه.
# دائم لا مؤقت: الصفحات لن تعود، والمؤقت يبقي القديم في الفهارس.
RewriteRule ^courses/?$ /catalog [R=301,L]
RewriteRule ^courses/(.*)$ /catalog [R=301,L]
RewriteRule ^books/?$ /catalog?type=book [R=301,L]

# التطوير المحلّي مستثنى: لا شهادة على localhost، والإجبار يقطع الخادم المحلّي.
# الشرط لا يُفعَّل في الإنتاج لأنّ المضيف هناك ليس localhost أبدًا.
RewriteCond %{HTTP_HOST} !^localhost [NC]
RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
</IfModule>

<IfModule mod_rewrite.c>

# تحويل الروابط القديمة إلى النظيفة — 301 حتى لا تضيع أرشفة ولا رابط محفوظ
RewriteRule ^home/?$ / [R=301,L]
RewriteRule ^home/courses/?$ /courses [R=301,L]
RewriteRule ^home/about_us/?$ /about [R=301,L]
RewriteRule ^home/contact_us/?$ /contact [R=301,L]
RewriteRule ^home/faq/?$ /faq [R=301,L]
RewriteRule ^home/terms_and_condition/?$ /terms [R=301,L]
RewriteRule ^home/privacy_policy/?$ /privacy [R=301,L]
RewriteRule ^home/refund_policy/?$ /refund [R=301,L]
RewriteRule ^home/my_courses/?$ /my-courses [R=301,L]
# الأخصّ قبل الأعمّ: القاعدة العامّة كانت تبتلع مسارَي المعلّم
# ووليّ الأمر فتحوّلهما إلى /student/... وهو عنوان غير موجود.
RewriteRule ^taqdar/teacher/?$ /teacher [R=301,L]
RewriteRule ^taqdar/teacher/(.*)$ /teacher/$1 [R=301,L]
RewriteRule ^taqdar/parent/?$ /parent [R=301,L]
RewriteRule ^taqdar/parent/(.*)$ /parent/$1 [R=301,L]
RewriteRule ^taqdar/?$ /student [R=301,L]
RewriteRule ^taqdar/(.*)$ /student/$1 [R=301,L]

RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?/$1 [L]
</IfModule>

# صفحات إعدادات لوحة الإدارة تتجاوز 1000 حقل
php_value max_input_vars 5000

# منع الوصول المباشر لنسخ الإعدادات الاحتياطية وملفّات المستودع.
#
# `md` و `sh` و `example` أُضيفت مع المستودع: التوثيق وسكربت النشر وقوالب
# الأسرار كلّها ملفّاتٌ حقيقيّة في جذر الويب، والملفّ الحقيقيّ يُخدَم كما هو.
# و `example` تحديدًا يُفصح عن أسماء المستخدمين وبنية الاتصال.
# الشقّ الثاني لعُرف النسخ في هذا المشروع: `<ملفّ>.bak-<وصف>-<تاريخ>` و
# `<ملفّ>.pre-<وصف>`. اللاحقة فيهما وسطٌ لا نهاية، فقاعدة `\.bak$` تخطئها
# كلَّها — و `Home.php.pre-404` شيفرةٌ كاملة تُقرأ لو خُدِمت.
<FilesMatch "\.(orig|bak|sql|log|md|sh|example|gitignore|gitattributes)$|\.(bak|pre)-">
    Require all denied
</FilesMatch>
