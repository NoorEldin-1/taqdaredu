# Normalise line endings in the repo to LF; check out native on Windows.
* text=auto

# Files the Linux server executes or parses line-by-line must stay LF even
# on a Windows checkout, or they break once uploaded.
*.sh      text eol=lf
*.mjs     text eol=lf
.htaccess text eol=lf

# Treat these as binary so git never rewrites their bytes.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.pdf   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.zip   binary
*.lockb binary
